# Copy to site/.env (next to docker-compose.yml) and chmod 600. Never commit it; .dockerignore keeps it
# out of the image build context.

# Required for the scan API and the MCP network tools. Generate with: openssl rand -hex 32
# The server disables both when the token is this placeholder or shorter than 32 characters.
SETTLENS_API_TOKEN=replace-with-a-long-random-token

# Optional: HTTPS webhook/CRM endpoint that also receives pilot submissions (server-side only),
# with an optional HMAC-SHA256 signature sent as x-settlens-signature.
# The server refuses to start with a webhook unless PILOT_WEBHOOK_DISCLOSED=1: /privacy says requests
# are not forwarded to any CRM or messaging service, so update it to name the recipient first.
# PILOT_WEBHOOK_URL=https://your-crm.example/webhooks/settlens
# PILOT_WEBHOOK_SECRET=replace-with-a-webhook-secret
# PILOT_WEBHOOK_DISCLOSED=1

# Set by docker-compose.yml, do not repeat here: HOST=0.0.0.0, TRUST_PROXY=1,
# PILOT_STORE=/data/pilot-leads.jsonl (host /opt/settlens-site/data). The container listens on 8080,
# published on 127.0.0.1:3318.
# Outside Docker (node site/server.js): PORT (default 8080), HOST (default 127.0.0.1),
# PILOT_STORE=<path to a JSON lines file>, TRUST_PROXY=1 only behind a proxy that overwrites
# X-Forwarded-For with the client address, SITE_ROOT (default site/public).

# Optional private single-owner workspace at /dashboard (separate from the API token).
# SETTLENS_MONITOR_TOKEN=<generate-a-dedicated-long-random-token>
# MONITOR_INTERVAL_MS=900000  # 0 disables scheduling, minimum 60000
# MONITOR_FAIL_ON=high
# MONITOR_WEBHOOK_URL=https://your-incident-system.example/webhook
# MONITOR_WEBHOOK_SECRET=<dedicated-signing-secret>
# MONITOR_STORE=/data/monitor.json (set by compose)
# MONITOR_ORIGIN=https://settlens.com (fixed origin; local development only: http://localhost:8080)

# Pilot requests and blocking monitor changes -> contact@settlens.com, with distinct subjects.
# Configure on the server only. Never put mailbox passwords in the repository or chat.
# SETTLENS_EMAIL_ENABLED=1
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@settlens.com
# SMTP_FROM=contact@settlens.com
# SMTP_PASSWORD=<mailbox-or-app-password>
# Or SMTP_PASSWORD_B64=<base64-encoded-password> (still a secret; mode600 server env only).
# Use scripts/configure-owner-smtp.py interactively to avoid dotenv interpolation.

# Legacy owner-only TLS notification relay. Its direct-MX delivery is unsigned
# and SPF-softfails with the current DNS; never use it for external outreach.
# Prefer authenticated Hostinger SMTP for owner notifications as well.
# SETTLENS_MAIL_RELAY_URL=https://195.35.28.51:3339/email
# SETTLENS_MAIL_RELAY_TOKEN=<dedicated-relay-credential-in-server-env-only>
# SETTLENS_MAIL_RELAY_CA=/data/relay-ca.pem
# SETTLENS_EMAIL_LOGIN=1  # One-time codes sent only to contact@settlens.com
# Production tunnel: relay TLS travels over a restricted SSH Unix socket.
# SETTLENS_MAIL_RELAY_SOCKET=/data/mail-relay.sock
