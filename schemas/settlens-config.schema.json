{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://settlens.com/schemas/settlens-config.schema.json",
  "title": "Settlens configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "targets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "failOn": {
      "$ref": "#/$defs/failOn"
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "$ref": "#/$defs/targetDefaults"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "failOn": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "none"
      ]
    },
    "headers": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          },
          {
            "not": {
              "pattern": "^[Pp][Aa][Yy][Mm][Ee][Nn][Tt]-[Ss][Ii][Gg][Nn][Aa][Tt][Uu][Rr][Ee]$"
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 65536,
        "pattern": "^[^\\r\\n]*$"
      }
    },
    "facilitator": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^https?://"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://",
              "maxLength": 8192
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "headers": {
              "$ref": "#/$defs/headers"
            }
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resourceUrl": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 8192
        },
        "schemes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
          }
        },
        "payTo": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxAmount": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "targetDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Za-z]+$"
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "type": "string",
          "maxLength": 1048576
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "facilitator": {
          "$ref": "#/$defs/facilitator"
        },
        "pricePolicy": {
          "$ref": "#/$defs/pricePolicy"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 8192
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Za-z]+$"
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "type": "string",
          "maxLength": 1048576
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "facilitator": {
          "$ref": "#/$defs/facilitator"
        },
        "pricePolicy": {
          "$ref": "#/$defs/pricePolicy"
        }
      }
    },
    "pricePolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "fixed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "minAmount",
            "maxAmount"
          ],
          "properties": {
            "mode": {
              "const": "range"
            },
            "minAmount": {
              "type": "string",
              "pattern": "^[0-9]{1,80}$"
            },
            "maxAmount": {
              "type": "string",
              "pattern": "^[0-9]{1,80}$"
            }
          }
        }
      ]
    }
  }
}
