{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://settlens.com/schemas/settlens-report.schema.json",
  "title": "Settlens evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "product",
    "productVersion",
    "protocol",
    "protocolVersion",
    "generatedAt",
    "scope",
    "integrations",
    "metadata",
    "summary",
    "targets",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reportId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}$"
    },
    "product": {
      "const": "Settlens"
    },
    "productVersion": {
      "type": "string"
    },
    "protocol": {
      "const": "x402"
    },
    "protocolVersion": {
      "const": 2
    },
    "generatedAt": {
      "type": "string"
    },
    "integrations": {
      "type": "object",
      "required": [
        "officialX402Core"
      ],
      "properties": {
        "officialX402Core": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetCount",
        "activeTargetCount",
        "settlementCalls",
        "privateKeysUsed"
      ],
      "properties": {
        "targetCount": {
          "type": "integer",
          "minimum": 1
        },
        "activeTargetCount": {
          "type": "integer",
          "minimum": 0
        },
        "settlementCalls": {
          "const": 0
        },
        "privateKeysUsed": {
          "const": 0
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/targetResult"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "enum": [
            "settlens-stable-json-v1",
            "settlens-stable-json-v2"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "warn",
        "skip"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "severity",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skip"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "message": {
          "type": "string"
        },
        "evidence": true,
        "recommendation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "targetResult": {
      "type": "object",
      "required": [
        "id",
        "name",
        "target",
        "mode",
        "startedAt",
        "completedAt",
        "summary",
        "checks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "target": {
          "type": "object"
        },
        "mode": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "completedAt": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "request": {
          "type": [
            "object",
            "null"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "supported": {
          "type": [
            "object",
            "null"
          ]
        },
        "integrations": {
          "type": "object"
        },
        "authorization": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
